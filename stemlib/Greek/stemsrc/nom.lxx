# LXX entries absent from the classical stemlibs.
# Generated by scripts/build_lxx_stemlib.py (LXX reference corpus).

# βροῦχος 'cough'
:le:brou=xos
:no:br-ou_x os_ou stem_acc masc

# παστοφόριον — generative 2nd-decl neuter
:le:pastofo/rion
:no:pastofori os_ou neut

# σάββατον 'Sabbath'
:le:sa/bbaton
:no:sabbat os_ou neut

# ταμιεῖον 'treasury'
:le:tamiei=on
:no:tamiei os_ou neut stem_acc

# ἀδελφιδός 'half-brother'
:le:a)delfido/s
:wd:a)delfido/s	indecl masc nom sg
:wd:a)delfi/dou	indecl masc gen sg
:wd:a)delfi/dw|	indecl masc dat sg
:wd:a)delfi/don	indecl masc acc sg
:wd:a)delfide/	indecl masc voc sg
:wd:a)delfi/des	indecl masc nom pl
:wd:a)delfi/dwn	indecl masc gen pl
:wd:a)delfi/dois	indecl masc dat pl
:wd:a)delfi/das	indecl masc acc pl

# αλληλουία — the corpus codes it as an interjection; Morpheus has no such POS, so it is registered as an indeclinable (no gender). The lemma keeps the corpus's accented + diaeresis spelling for lemma matching; both surface spellings are indexed.
:le:a)llhlou/i+a
:wd:allhlouia	indecl nom sg
:wd:a)llhlou/i+a	indecl nom sg

# ἀμνός — the nom01 entry is restricted to nom; full paradigm added
:le:a)mno/s
:wd:a)mno/s	indecl masc nom sg
:wd:a)mnou=	indecl masc gen sg
:wd:a)mnw=|	indecl masc dat sg
:wd:a)mno/n	indecl masc acc sg
:wd:a)mnoi/	indecl masc nom pl
:wd:a)mnw=n	indecl masc gen pl
:wd:a)mnoi=s	indecl masc dat pl
:wd:a)mnou/s	indecl masc acc pl

# ἀντιλήμπτωρ 'one who receives against' (only two forms attested in LXX)
:le:a)ntilh/mptwr
:wd:a)ntilh/mptwr	indecl masc nom sg
:wd:a)ntilh/mptores	indecl masc nom pl

# νοσσία — no -ία noun pattern exists, so explicit forms (all attested in LXX). standword() rewrites GRAVE to ACUTE on every input and CheckGenWords compares accents exactly in normal mode, so stored forms use the accent each corpus spelling standardizes to: word-final graves become acute (the corpus spells acc sg both ways), circumflexes are kept.
:le:nossi/a
:wd:nossia/n	indecl fem acc sg
:wd:nossia=|	indecl fem dat sg
:wd:nossiai/	indecl fem nom pl
:wd:nossia=s	indecl fem gen sg
:wd:nossia/s	indecl fem acc pl

# τρυβλίον 'bowl'
:le:trubli/on
:wd:trubli/on	indecl neut nom sg
:wd:trubli/ou	indecl neut gen sg
:wd:trubli/w|	indecl neut dat sg
:wd:trubli/a	indecl neut nom pl
:wd:trubli/wn	indecl neut gen pl
:wd:trubli/ois	indecl neut dat pl

